# Written by setup.sh; edit the paths below. Entry points read this file themselves.
#
# IMPEDIT_DATA    datasets + faiss indexes + target manifests   (read-only)
# IMPEDIT_MODELS  CLIP / victim MLLM / SD3.5 weights            (read-only)
# IMPEDIT_WORK    edits, poisoned images, results, logs         (writable)
# IMPEDIT_HF_HOME HuggingFace cache

IMPEDIT_DATA=/path/to/data
IMPEDIT_MODELS=/path/to/models
IMPEDIT_WORK=/path/to/work
IMPEDIT_HF_HOME=$HOME/.cache/huggingface

# CUDA devices (comma-separated); the pipeline uses one GPU per long-lived role
EDIT_GPU=0
EVAL_GPU=0
PAYLOAD_GPU=0
RENDER_GPU=0
SURROGATE_GPU=0

# Only needed when regenerating payloads from scratch (see the README).
# The released poisoned images do not require it.
DASHSCOPE_API_KEY=

# Set to 1 to allow the model libraries to download from the hub.
IMPEDIT_ONLINE=0

# Cap BLAS threads on shared machines; one evaluation process is enough.
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8
OPENBLAS_NUM_THREADS=8
