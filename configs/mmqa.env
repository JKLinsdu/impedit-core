# MMQA protocol — sourced by scripts/_common.sh.
# Every value is a default: an environment variable set by the caller wins.
BENCH="${BENCH:-mmqa}"

# retrieval / generation protocol
PROTOCOL_K="${PROTOCOL_K:-1}"          # recall is reported at k=1 on MMQA
CLIP_TOPK="${CLIP_TOPK:-1}"
NUM_P="${NUM_P:-1}"
RERANK_TOPK="${RERANK_TOPK:-5}"

# evaluation set
TARGETS="${TARGETS:-100}"

# edit training
EDIT_LAMBDA="${EDIT_LAMBDA:-0.01}"
EDIT_STEPS="${EDIT_STEPS:-800}"

# artifacts
INDEX_FILE="${INDEX_FILE:-${IMPEDIT_DATA}/index/MMQA_test_image_clip.index}"
POISON_JSON="${POISON_JSON:-${IMPEDIT_WORK}/poisoned/poison_mmqa.json}"
EDIT_FILE="${EDIT_FILE:-${IMPEDIT_WORK}/edits/mm_prod_800.pt}"
