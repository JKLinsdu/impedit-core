# WebQA protocol — sourced by scripts/_common.sh.
# Every value is a default: an environment variable set by the caller wins.
BENCH="${BENCH:-webqa}"

# retrieval / generation protocol
PROTOCOL_K="${PROTOCOL_K:-2}"          # WebQA's official metric is recall at k=2
CLIP_TOPK="${CLIP_TOPK:-2}"
NUM_P="${NUM_P:-1}"            # one poisoned image per target query (paper §3.1)
RERANK_TOPK="${RERANK_TOPK:-5}"

# evaluation set
TARGETS="${TARGETS:-100}"

# edit training
EDIT_LAMBDA="${EDIT_LAMBDA:-0.01}"
EDIT_STEPS="${EDIT_STEPS:-800}"

# artifacts
INDEX_FILE="${INDEX_FILE:-${IMPEDIT_DATA}/index/WebQA_test_image_clip.index}"
POISON_JSON="${POISON_JSON:-${IMPEDIT_WORK}/poisoned/poison_webqa.json}"
EDIT_FILE="${EDIT_FILE:-${IMPEDIT_WORK}/edits/wq_prod_800.pt}"
